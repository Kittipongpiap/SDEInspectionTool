def _build_rtt_transport_from_ui(ui) -> RTTTransport:
    # Try to fetch config from UI if available; else use defaults
    device = getattr(ui, "jlinkDeviceBox", None).currentText() if hasattr(ui, "jlinkDeviceBox") else "nRF52833_xxAA"
    speed_khz = int(getattr(ui, "jlinkSpeedBox", None).value()) if hasattr(ui, "jlinkSpeedBox") else 4000
    up_idx = int(getattr(ui, "jlinkUpIdxBox", None).value()) if hasattr(ui, "jlinkUpIdxBox") else 0

    # Optional: serial number of J-Link probe
    serial_no = None
    if hasattr(ui, "jlinkSerialBox"):
        try:
            text = ui.jlinkSerialBox.currentText()
            serial_no = int(text) if text and text.isdigit() else None
        except Exception:
            serial_no = None

    return RTTTransport(
        device=device,
        interface="SWD",
        speed_khz=speed_khz,
        serial_no=serial_no,
        up_buffer_index=up_idx,
    )

# Main reader (replacement of ReadSerial_Controller)
def ReadRTT_Controller(ui):
    act_stack = []
    curr_stack = []
    scd_stack = []
    pm_stack = []

    start = True
    device_type = 'Incomming Controlller Board'  # keep original spelling to avoid ripple

    # Prepare RTT transport
    transport = _build_rtt_transport_from_ui(ui)

    try:
        # If you still need a target reset before reading:
        # (Ensure no collision with RTT session; we reset BEFORE opening RTT)
        try:
            jlink.reset()
        except Exception:
            pass

        transport.open()
        print("Status : RTT connected successfully.")

        while start:
            line = transport.read_line(timeout=0.1)
            if not line:
                continue

            # the received Sensor Data =====================================================
            if line.startswith('<info> app: sensor_type,data_1,data_2,data_3:'):
                device_type = 'Sensor Controller'
                sensor_data = line.strip()
                raw_data = sensor_data[46:]
                print(raw_data)

                if raw_data.startswith("2"):
                    pm_array = raw_data.split(',')[1:]
                    for pm in pm_array:
                        pm_pack = struct.pack('I', int(pm))
                        pm_float = struct.unpack('f', pm_pack)[0]
                        pm_float = int(pm_float)
                        pm_stack.append(pm_float)

                if raw_data.startswith("3"):
                    scd_array = raw_data.split(',')[1:]
                    for scd in scd_array:
                        scd_pack = struct.pack('I', int(scd))
                        scd_float = struct.unpack('f', scd_pack)[0]
                        scd_float = int(scd_float)
                        scd_stack.append(scd_float)

                    end_process_(ui, device_type, pm_stack, scd_stack)
                    break

            # the received Actuator Data ==================================================
            elif line.startswith('<info> app: Relay output'):
                device_type = 'Actuator Controller 3CH'
                act_data = line.strip()
                act_stat = act_data[25:]
                if len(act_stack) < 5:
                    act_stack.append(act_stat)

            elif line.startswith('<info> app: Current output'):
                device_type = 'Actuator Controller 3CH'
                act_curr = line.strip()
                act_amp = act_curr[27:]
                if len(curr_stack) < 5:
                    curr_stack.append(act_amp)

            # End condition for actuator controller ======================================
            if len(curr_stack) == 5:
                print("End Level")
                end_process_(ui, device_type, act_stack, curr_stack)
                break

    except Exception as e:
        print("Error opening or reading RTT:", e)

    finally:
        try:
            transport.close()
            print("Status : RTT closed.")
        except Exception:
            pass

def end_process_(ui, controller_type, first_stack, second_stack):
    mac_id = jlink.mac_id_check()
    print(controller_type)
    for first in first_stack:
        print(first)
    for second in second_stack:
        print(second)

    #-------------------------------------------------------------------------------
    comperator.Comparator(ui, mac_id, controller_type, first_stack, second_stack)
    status = comperator.return_status()
    #-------------------------------------------------------------------------------
    if status.startswith("GOOD"):
        uif.afterLife_event(ui)
        ui.flashStatusLabel.setText(
            'Status : <span style="color:ORANGE">Production Process Inprogress</span></p>'
        )
    elif status.startswith("NG"):
        jlink.protection()
        jlink.recover()
        ui.flashStatusLabel.setText(
            'Status : <span style="color:green">Process Complete </span></p>'
        )

# ======================================================================
# PyQt5 Signals Reader (threaded) using RTTTransport backend
# ======================================================================

class SerialReader(QObject):
    """DEPRECATED name kept for UI compatibility. Now uses RTT transport inside."""
    new_data = pyqtSignal(str)
    error_occurred = pyqtSignal(str)

    def __init__(self, transport: LineTransport):
        super().__init__()
        self.transport = transport
        self.reading = False
        self.thread: Optional[QThread] = None

    def start_reading(self):
        self.reading = True
        self.thread = QThread()
        self.moveToThread(self.thread)
        self.thread.started.connect(self.read_from_transport)
        self.thread.start()

    def stop_reading(self):
        self.reading = False
        if self.thread and self.thread.isRunning():
            self.thread.quit()
            self.thread.wait()

    def read_from_transport(self):
        try:
            self.transport.open()
        except Exception as e:
            self.error_occurred.emit(f"Error opening RTT: {e}")
            return

        while self.reading:
            try:
                line = self.transport.read_line(timeout=0.05)
                if line is not None:
                    self.new_data.emit(line)
                else:
                    time.sleep(0.005)  # keep CPU low
            except Exception as e:
                self.error_occurred.emit(f"Error reading from RTT: {e}")
                break

        try:
            self.transport.close()
        except Exception:
            pass

# Function to start reading via RTT (UI glue)
def start_reading(ui):
    global serial_reader
    transport = _build_rtt_transport_from_ui(ui)
    serial_reader = SerialReader(transport)
    serial_reader.new_data.connect(lambda line: update_ui(ui, line))
    serial_reader.error_occurred.connect(lambda error: ui.serial_monitor.append(error))
    serial_reader.start_reading()
    ui.serial_monitor.clear()
    ui.serial_monitor.append("Started reading from RTT (J-Link).")

def stop_reading(ui):
    global serial_reader
    if 'serial_reader' in globals() and serial_reader.reading:
        serial_reader.stop_reading()
        ui.serial_monitor.append("Stopped reading from RTT.")

def update_ui(ui, line):
    ui.serial_monitor.append(line)
    ui.serial_monitor.moveCursor(QTextCursor.End)
    ui.serial_monitor.ensureCursorVisible()