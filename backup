# ============================================================
# Transport Abstraction (line-oriented)
# ============================================================

class LineTransport:
    """Abstract base transport for line-based reading."""
    def open(self) -> None:
        raise NotImplementedError

    def close(self) -> None:
        raise NotImplementedError

    def read_line(self, timeout: Optional[float] = None) -> Optional[str]:
        """Return a decoded line (str) without trailing newline, or None if no data before timeout."""
        raise NotImplementedError

# ============================================================
# RTT Transport via J-Link
# ============================================================

class RTTTransport(LineTransport):
    def __init__(
        self,
        device: str = "nRF52840_xxAA",
        interface: str = "SWD",
        speed_khz: int = 4000,
        serial_no: Optional[int] = None,
        up_buffer_index: int = 0,
    ) -> None:
        self.device = device
        self.interface = interface
        self.speed_khz = speed_khz
        self.serial_no = serial_no
        self.up_idx = up_buffer_index

        self.jl = pylink.JLink()
        self._buf = bytearray()
        self._opened = False

    def open(self) -> None:
        # Open the probe
        if self.serial_no:
            self.jl.open(self.serial_no)
        else:
            self.jl.open()

        # Set interface
        if self.interface.upper() == "SWD":
            self.jl.set_tif(pylink.enums.JLinkInterfaces.SWD)
        else:
            self.jl.set_tif(pylink.enums.JLinkInterfaces.JTAG)

        # Connect to target
        self.jl.connect(self.device, speed=self.speed_khz)

        # Ensure target is running so RTT can execute
        try:
            if self.jl.halted():
                self.jl.go()
        except pylink.JLinkException:
            # Some MCUs may not support halted() query the same way; ignore
            pass

        # Start RTT and wait for Control Block
        self.jl.rtt_start()
        t0 = time.time()
        while not self.jl.rtt_is_active() and (time.time() - t0) < 2.0:
            time.sleep(0.01)
        if not self.jl.rtt_is_active():
            # Still proceed; reads may fail until RTT becomes active
            pass

        self._opened = True

    def close(self) -> None:
        try:
            if self._opened and self.jl.rtt_is_active():
                self.jl.rtt_stop()
        except Exception:
            pass
        finally:
            try:
                if self.jl.opened():
                    self.jl.close()
            except Exception:
                pass
            self._opened = False

    def read_line(self, timeout: Optional[float] = None) -> Optional[str]:
        """Non-blocking-ish read: poll RTT, assemble bytes until newline, return decoded line."""
        deadline = time.time() + (timeout or 0.05)
        while time.time() < deadline:
            try:
                chunk = self.jl.rtt_read(self.up_idx, 1024)  # bytes or bytearray
                if chunk:
                    self._buf.extend(chunk)
                    nl = self._buf.find(b'\n')
                    if nl != -1:
                        line = self._buf[:nl + 1]
                        del self._buf[:nl + 1]
                        return line.decode('utf-8', errors='ignore').strip()
            except pylink.JLinkException:
                # If RTT momentarily unavailable, yield a bit
                time.sleep(0.005)
                continue
            time.sleep(0.005)
        return None

